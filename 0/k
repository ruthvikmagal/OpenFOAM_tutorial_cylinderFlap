FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.0015;

boundaryField
{

    front
    {
        type            empty;
    }

    back
    {
        type            empty;
    }
    
    inlet
    {
    	type  		fixedValue;
   	value 		$internalField;
    }


    outlet
    {
        type            zeroGradient;
    }

    "(top|bottom)"
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    "(cylinder|flap)"
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    
}


