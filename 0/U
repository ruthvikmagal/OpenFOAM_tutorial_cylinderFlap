FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0.001";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];


internalField   uniform (0 0 0);

boundaryField
{
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    inlet
    {
	//type		fixedValue;
	//value           uniform (2 0 0);

        type            uniformFixedValue;
        uniformValue    table
        3(
	(0 (1 0 0))
	(0.5 (1 1 0))
	(1 (2 1 0))
	)
	;
        
    }
    outlet
    {
        type            zeroGradient;
    }
    top
    {
        type            noSlip;
    }
    bottom
    {
        type            noSlip;
    }
    flap
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }
    cylinder
    {
        type            noSlip;
    }
}


